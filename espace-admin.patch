@@ -0,0 +1,109 @@
+"use client";
+
+import { useEffect, useState, type CSSProperties, type ReactNode } from "react";
+import { LogOut, Menu, X } from "lucide-react";
+import { COULEUR_PAR_DEFAUT, couleurTexte, couleurValide, initiales } from "@/lib/espace";
+import { Button } from "@/components/ui/button";
+import { useEspace } from "./espace-context";
+import { LogoEntreprise, Sidebar } from "./sidebar";
+
+export function EspaceShell({ children }: { children: ReactNode }) {
+  const { profil, perso, deconnecter } = useEspace();
+  const [menuOuvert, setMenuOuvert] = useState(false);
+
+  // Couleur principale de l'entreprise, avec vérification du format avant de l'injecter
+  const accent = couleurValide(perso?.couleur_principale) ? perso.couleur_principale : COULEUR_PAR_DEFAUT;
+  const variables = { "--espace-accent": accent, "--espace-accent-fg": couleurTexte(accent) } as CSSProperties;
+
+  useEffect(() => {
+    if (!menuOuvert) return;
+    const surTouche = (e: KeyboardEvent) => {
+      if (e.key === "Escape") setMenuOuvert(false);
+    };
+    window.addEventListener("keydown", surTouche);
+    return () => window.removeEventListener("keydown", surTouche);
+  }, [menuOuvert]);
+
+  return (
+    <div style={variables} className="flex min-h-screen flex-1 bg-muted/30">
+      <a
+        href="#contenu"
+        className="sr-only z-50 rounded-md bg-background px-3 py-2 text-sm focus:not-sr-only focus:fixed focus:left-3 focus:top-3"
+      >
+        Aller au contenu
+      </a>
+
+      {/* Menu fixe (grands écrans) */}
+      <aside className="sticky top-0 hidden h-screen w-64 shrink-0 border-r bg-sidebar lg:block">
+        <Sidebar />
+      </aside>
+
+      {/* Menu en tiroir (petits écrans) */}
+      {menuOuvert && (
+        <div className="fixed inset-0 z-40 lg:hidden">
+          <button
+            type="button"
+            aria-label="Fermer le menu"
+            className="absolute inset-0 bg-black/40"
+            onClick={() => setMenuOuvert(false)}
+          />
+          <aside className="absolute inset-y-0 left-0 w-72 max-w-[85vw] border-r bg-sidebar shadow-xl">
+            <Button
+              variant="ghost"
+              size="icon-sm"
+              className="absolute right-2 top-2.5"
+              aria-label="Fermer le menu"
+              onClick={() => setMenuOuvert(false)}
+            >
+              <X />
+            </Button>
+            <Sidebar onNavigate={() => setMenuOuvert(false)} />
+          </aside>
+        </div>
+      )}
+
+      <div className="flex min-w-0 flex-1 flex-col">
+        <header className="sticky top-0 z-30 flex h-14 items-center gap-3 border-b bg-background/85 px-4 backdrop-blur lg:px-8">
+          <Button
+            variant="ghost"
+            size="icon"
+            className="lg:hidden"
+            aria-label="Ouvrir le menu"
+            aria-expanded={menuOuvert}
+            onClick={() => setMenuOuvert(true)}
+          >
+            <Menu />
+          </Button>
+          <div className="flex min-w-0 items-center gap-2 lg:hidden">
+            <LogoEntreprise className="size-6 text-xs" />
+            <span className="truncate text-sm font-semibold">{perso?.nom_entreprise ?? profil.entreprise}</span>
+          </div>
+
+          <div className="ml-auto flex items-center gap-3">
+            <div className="hidden text-right leading-tight sm:block">
+              <p className="text-sm font-medium">
+                {profil.prenom} {profil.nom}
+              </p>
+              <p className="text-xs text-muted-foreground">{profil.role}</p>
+            </div>
+            <span
+              aria-hidden
+              className="grid size-8 place-items-center rounded-full bg-[var(--espace-accent)] text-xs font-semibold text-[var(--espace-accent-fg)]"
+            >
+              {initiales(profil.prenom, profil.nom)}
+            </span>
+            <Button variant="outline" size="sm" onClick={deconnecter}>
+              <LogOut aria-hidden />
+              <span className="hidden sm:inline">Se déconnecter</span>
+              <span className="sr-only sm:hidden">Se déconnecter</span>
+            </Button>
+          </div>
+        </header>
+
+        <main id="contenu" className="flex-1 px-4 py-6 lg:px-8">
+          <div className="mx-auto w-full max-w-6xl">{children}</div>
+        </main>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/components/espace/sidebar.tsx b/frontend/src/components/espace/sidebar.tsx
new file mode 100644
index 0000000..0e2cc43
--- /dev/null
+++ b/frontend/src/components/espace/sidebar.tsx
@@ -0,0 +1,109 @@
+"use client";
+
+import Link from "next/link";
+import { usePathname } from "next/navigation";
+import { NAV, afficher } from "@/lib/espace";
+import { cn } from "@/lib/utils";
+import { useEspace } from "./espace-context";
+
+export function LogoEntreprise({ className }: { className?: string }) {
+  const { profil, perso } = useEspace();
+  const nom = perso?.nom_entreprise ?? profil.entreprise ?? "";
+
+  if (perso?.logo_url) {
+    // eslint-disable-next-line @next/next/no-img-element
+    return <img src={perso.logo_url} alt="" className={cn("size-8 rounded-md object-contain", className)} />;
+  }
+  return (
+    <span
+      aria-hidden
+      className={cn(
+        "grid size-8 place-items-center rounded-md bg-[var(--espace-accent)] text-sm font-semibold text-[var(--espace-accent-fg)]",
+        className,
+      )}
+    >
+      {nom.charAt(0).toUpperCase() || "?"}
+    </span>
+  );
+}
+
+export function Sidebar({ onNavigate }: { onNavigate?: () => void }) {
+  const { profil, perso } = useEspace();
+  const pathname = usePathname();
+
+  // On ne montre que les entrées auxquelles le rôle a droit (permission + module actif)
+  const groupes = NAV.map((g) => ({ ...g, items: g.items.filter((i) => afficher(profil, i)) })).filter(
+    (g) => g.items.length > 0,
+  );
+
+  return (
+    <div className="flex h-full flex-col">
+      <div className="flex h-14 shrink-0 items-center gap-2.5 border-b px-4">
+        <LogoEntreprise />
+        <span className="truncate text-sm font-semibold">{perso?.nom_entreprise ?? profil.entreprise}</span>
+      </div>
+
+      <nav aria-label="Navigation principale" className="flex-1 space-y-5 overflow-y-auto px-3 py-4">
+        {groupes.map((groupe) => (
+          <div key={groupe.titre ?? "principal"}>
+            {groupe.titre && (
+              <p className="mb-1.5 px-2 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
+                {groupe.titre}
+              </p>
+            )}
+            <ul className="space-y-0.5">
+              {groupe.items.map((item) => {
+                const Icone = item.icone;
+                const actif = item.href
+                  ? item.href === "/espace"
+                    ? pathname === "/espace"
+                    : pathname === item.href || pathname.startsWith(`${item.href}/`)
+                  : false;
+
+                if (!item.href) {
+                  return (
+                    <li key={item.libelle}>
+                      <span
+                        aria-disabled="true"
+                        className="flex cursor-not-allowed items-center gap-2.5 rounded-lg px-2 py-1.5 text-sm text-muted-foreground/70"
+                      >
+                        <Icone className="size-4 shrink-0" aria-hidden />
+                        <span className="truncate">{item.libelle}</span>
+                        <span className="ml-auto rounded-full bg-muted px-1.5 py-0.5 text-[10px] font-medium">
+                          Bientôt
+                        </span>
+                      </span>
+                    </li>
+                  );
+                }
+
+                return (
+                  <li key={item.libelle}>
+                    <Link
+                      href={item.href}
+                      onClick={onNavigate}
+                      aria-current={actif ? "page" : undefined}
+                      className={cn(
+                        "relative flex items-center gap-2.5 rounded-lg px-2 py-1.5 text-sm transition-colors outline-none focus-visible:ring-3 focus-visible:ring-ring/50",
+                        actif ? "bg-muted font-medium text-foreground" : "text-foreground/80 hover:bg-muted/60",
+                      )}
+                    >
+                      {actif && (
+                        <span
+                          aria-hidden
+                          className="absolute inset-y-1.5 -left-3 w-1 rounded-r-full bg-[var(--espace-accent)]"
+                        />
+                      )}
+                      <Icone className="size-4 shrink-0" aria-hidden />
+                      <span className="truncate">{item.libelle}</span>
+                    </Link>
+                  </li>
+                );
+              })}
+            </ul>
+          </div>
+        ))}
+      </nav>
+    </div>
+  );
+}
diff --git a/frontend/src/components/espace/tableau-de-bord.tsx b/frontend/src/components/espace/tableau-de-bord.tsx
