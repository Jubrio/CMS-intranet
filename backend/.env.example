APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Stockage des fichiers envoyés : local (disque du serveur) ou s3 (Cloudflare R2, Backblaze B2...).
# En production sur un hébergeur à disque temporaire, utilisez s3, sinon les fichiers disparaissent.
FILES_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Hébergeur qui bloque le SMTP (Render gratuit) : MAIL_MAILER=brevo et clé API ci-dessous
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# Pour Cloudflare R2 : AWS_ENDPOINT=https://<ID_COMPTE>.r2.cloudflarestorage.com, région « auto », path style à true
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

SANCTUM_TOKEN_EXPIRATION=480

# Origine du frontend autorisée par CORS (https://mon-site.vercel.app en production)
FRONTEND_URL=http://localhost:3000

# Captcha de la création d'intranet (Cloudflare Turnstile). Obligatoire en production.
TURNSTILE_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"
